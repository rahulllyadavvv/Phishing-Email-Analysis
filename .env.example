# Copy to .env and fill in. Never commit .env.
VIRUSTOTAL_API_KEY=
ABUSECH_API_KEY=
GOOGLE_SAFEBROWSING_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
HYBRID_ANALYSIS_API_KEY=
CAPE_BASE_URL=
# Only if your CAPE instance requires API authentication
CAPE_API_TOKEN=
LLM_API_KEY=
UPLOAD_FILES_TO_VT=false
# VirusTotal: engines flagging malicious needed for a malicious verdict
VT_MALICIOUS_THRESHOLD=3
# Hybrid Analysis: submitting files uploads them to a public third party (opt-in)
UPLOAD_FILES_TO_HYBRID_ANALYSIS=false
HYBRID_ANALYSIS_ENVIRONMENT_ID=160
# Largest accepted input in MB (default 25)
MAX_INPUT_SIZE_MB=25
PHISHLENS_API_KEY=
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///phishlens.sqlite
# DNS helper: query timeout (s), cache lifetime (s), SQLite cache on/off and file
DNS_TIMEOUT_SECONDS=5
DNS_CACHE_TTL_SECONDS=3600
DNS_SQLITE_CACHE=true
DNS_CACHE_PATH=phishlens_dns_cache.sqlite
# urlscan.io: scan visibility (public/unlisted/private; unlisted scans are still visible to
# urlscan and its partners, so URLs with personal data may be exposed), max seconds to wait for
# a scan, and reuse existing scans of the same URL from the last N days (0 = always submit)
URLSCAN_VISIBILITY=unlisted
URLSCAN_MAX_WAIT_SECONDS=90
URLSCAN_REUSE_DAYS=7
# Archive unpacking limits (zip bomb protection): nesting depth, files, total MB, seconds per file
ARCHIVE_MAX_DEPTH=3
ARCHIVE_MAX_FILES=100
ARCHIVE_MAX_TOTAL_MB=200
ARCHIVE_FILE_TIMEOUT_SECONDS=10
# File extensions treated as high risk (comma-separated; empty keeps the built-in list)
HIGH_RISK_EXTENSIONS=
# Folder with YARA rules (*.yar, *.yara); empty uses data/yara
YARA_RULES_DIR=
# Enrichment HTTP clients (VirusTotal, abuse.ch, RDAP, ...): timeout (s), retries for
# 429/5xx/timeouts, result cache on/off and file
ENRICHMENT_TIMEOUT_SECONDS=15
ENRICHMENT_MAX_RETRIES=3
ENRICHMENT_CACHE=true
ENRICHMENT_CACHE_PATH=phishlens_enrichment_cache.sqlite
# Per-service cache lifetime in seconds (default 86400), e.g. virustotal=3600,rdap=604800
ENRICHMENT_CACHE_TTL=
# Per-service rate limits as requests/seconds, e.g. virustotal=500/60,urlscan=120/60
# Defaults: virustotal=4/60 abuseipdb=1000/86400 hybrid_analysis=5/60 urlscan=60/60 rdap=1/1
# abusech, google_safebrowsing, cape=10/1
ENRICHMENT_RATE_LIMITS=
# DKIM: signatures older than this many days at delivery are flagged as possible replays
DKIM_MAX_AGE_DAYS=7
# Comma-separated lists
TRUSTED_AUTHSERV_IDS=
TRUSTED_INTERNAL_HOSTS=
TRUSTED_ARC_SEALERS=
