# Copy to .env and fill in. Never commit .env.
VIRUSTOTAL_API_KEY=
ABUSECH_API_KEY=
GOOGLE_SAFEBROWSING_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
HYBRID_ANALYSIS_API_KEY=
CAPE_BASE_URL=
LLM_API_KEY=
UPLOAD_FILES_TO_VT=false
# Largest accepted input in MB (default 25)
MAX_INPUT_SIZE_MB=25
PHISHLENS_API_KEY=
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///phishlens.sqlite
# DNS helper: query timeout (s), cache lifetime (s), SQLite cache on/off and file
DNS_TIMEOUT_SECONDS=5
DNS_CACHE_TTL_SECONDS=3600
DNS_SQLITE_CACHE=true
DNS_CACHE_PATH=phishlens_dns_cache.sqlite
# DKIM: signatures older than this many days at delivery are flagged as possible replays
DKIM_MAX_AGE_DAYS=7
# Comma-separated lists
TRUSTED_AUTHSERV_IDS=
TRUSTED_INTERNAL_HOSTS=
TRUSTED_ARC_SEALERS=
